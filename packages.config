<?xml version="1.0" encoding="utf-8"?>
<!--
  WDK + SDK as NuGet packages, for building the ARM64 KMDF drivers in CI
  without a WDK *installer*. This mirrors Microsoft's own Windows-driver-samples
  CI (microsoft/Windows-driver-samples, .github/workflows/ci.yml): restore with
    nuget restore packages.config -PackagesDirectory packages\
  then build with msbuild. driver/Directory.Build.props wires the restored
  packages into the driver projects.

  Installer-based provisioning (wdksetup.exe / choco) proved unreliable on
  hosted runners — it exits 0 without landing Include\<ver>\km\ntddk.h, so the
  driver build's MatchingWdkPresent check fails. NuGet avoids registration
  entirely. ARM64 is our only target, so only the arm64 + base packages are
  listed (x64 packages from the upstream sample are omitted).

  Version tracks the windows-2025-vs2026 runner image the workflow uses.
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP"       version="10.0.28000.1839" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.arm64" version="10.0.28000.1839" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.arm64"     version="10.0.28000.1839" targetFramework="native" />
</packages>
