;
; rkvdec.inx — Rockchip RK3588 H.264 / HEVC video decoder driver.
; Matches RKCP3550 (RKVDEC v2) only.  UID 0 = RVD0, UID 1 = RVD1.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = Media
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = ; will be stamped by stampinf
CatalogFile = rkvdec.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
rkvdec.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%rkvdec.DeviceDesc% = rkvdec_Inst, ACPI\RKCP3550

[rkvdec_Inst.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
rkvdec.sys

; Device-level security.  PnP-managed FDOs must set security via INF
; AddReg, not via WdfDeviceInitAssignSDDLString (that API is for control
; devices only; using it here makes the device fail PnP load with a
; SECURITY_DESCRIPTOR complaint in Device Manager — see commit 4cf23bf).
; Policy:
;   SY (Local System)        — all access
;   BA (Built-in Admins)     — all access
;   AU (Authenticated Users) — read/write/execute, so any non-anonymous
;                              user can open the device through the MFT.
; Anonymous tokens are denied.  FILE_DEVICE_SECURE_OPEN (0x100) propagates
; the ACL to namespace opens / child PDOs.
[rkvdec_Inst.NT.HW]
AddReg = rkvdec_HW_AddReg

[rkvdec_HW_AddReg]
HKR,, "Security", , "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGWGX;;;AU)"
HKR,, "DeviceCharacteristics", 0x10001, 0x00000100

[rkvdec_Inst.NT.Services]
AddService = rkvdec, %SPSVCINST_ASSOCSERVICE%, rkvdec_Service_Inst

[rkvdec_Service_Inst]
DisplayName    = %rkvdec.SVCDESC%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\rkvdec.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "Vibe Coder"
DiskName               = "rkvdec Installation Disk"
rkvdec.DeviceDesc      = "Rockchip RK3588 RKVDEC v2 H.264 / HEVC decoder"
rkvdec.SVCDESC         = "rkvdec Service"
