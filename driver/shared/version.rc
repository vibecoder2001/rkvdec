// Shared VERSIONINFO resource for all rkvdec/rkav1d driver-suite binaries.
// Stamps the .sys PE with FileVersion / ProductVersion so the deployed
// drivers self-report their release version (was 0.0.0.0 before this).
//
// Self-contained: uses only rc.exe built-in statement keywords plus the
// numeric constants below, so no <windows.h> include is required.
//
//   FILEOS      0x00040004 = VOS_NT_WINDOWS32
//   FILETYPE    0x3        = VFT_DRV
//   FILESUBTYPE 0x7        = VFT2_DRV_SYSTEM

#include "version.h"

1 VERSIONINFO
 FILEVERSION    RKMPP_VERSION_COMMA
 PRODUCTVERSION RKMPP_VERSION_COMMA
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x00040004L
 FILETYPE       0x3L
 FILESUBTYPE    0x7L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vibe Coder"
            VALUE "FileDescription",  "Rockchip RK3588 video decoder driver suite"
            VALUE "FileVersion",      RKMPP_VERSION_STR
            VALUE "ProductName",      "rkvdec driver suite"
            VALUE "ProductVersion",   RKMPP_VERSION_STR
            VALUE "LegalCopyright",   "Vibe Coder"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
